include(CMakeFindDependencyMacro)

set(_streamingtoolbox_saved_module_path "${CMAKE_MODULE_PATH}")
list(PREPEND CMAKE_MODULE_PATH "@PROJECT_SOURCE_DIR@/cmake")
find_dependency(FFmpeg REQUIRED COMPONENTS @STREAMINGTOOLBOX_FFMPEG_REQUIRED_COMPONENTS@)
set(CMAKE_MODULE_PATH "${_streamingtoolbox_saved_module_path}")
unset(_streamingtoolbox_saved_module_path)

include("${CMAKE_CURRENT_LIST_DIR}/StreamingToolBoxTargets.cmake")